# Data and results are intentionally outside this code-only distribution.
/data/
/input/
/results/
/output/
# Manuscript material is not distributed. The one exception is the figure
# programs themselves, which are code and are part of the released pipeline.
# Anything those programs write (PNG, PDF, CSV) remains ignored.
/paper/*
!/paper/RCR/
/paper/RCR/*
!/paper/RCR/figure_build/
!/paper/RCR/figure_build/*.py
*.csv
*.xlsx
*.xls
*.parquet
*.geojson
*.shp
*.dbf
*.shx
*.tif
*.tiff
*.png
*.pdf
*.docx
*.zip
*.log
*.lic
.env*
*credentials*
*token*
.venv/
__pycache__/
*.py[cod]
.DS_Store
.pytest_cache/
/local_test_report.txt
